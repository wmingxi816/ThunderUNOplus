{
  "name": "@thunder-uno/client-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "corepack pnpm --filter @thunder-uno/shared-types build && corepack pnpm --filter @thunder-uno/protocol build && corepack pnpm --filter @thunder-uno/client-web typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@thunder-uno/protocol": "workspace:*",
    "@thunder-uno/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.12"
  }
}
